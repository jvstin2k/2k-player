<Window
    x:Class="UhfPlayer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:UhfPlayer.App"
    Title="UHF Player">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="GroupsColumn" Width="220" />
            <ColumnDefinition x:Name="ChannelsColumn" Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Groups -->
        <Grid Padding="12,12,6,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="SectionBar" Margin="0,0,0,8" SelectionChanged="OnSectionChanged">
                <SelectorBarItem Text="Live TV" />
                <SelectorBarItem Text="Filme" />
                <SelectorBarItem Text="Serien" />
            </SelectorBar>
            <ListView x:Name="GroupList" Grid.Row="1" SelectionChanged="OnGroupSelected" />
            <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button HorizontalAlignment="Stretch" Click="OnAddSource">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Add" />
                        <TextBlock Text="Quelle hinzufügen" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Click="OnManageSources" ToolTipService.ToolTip="Quellen verwalten">
                    <SymbolIcon Symbol="Setting" />
                </Button>
            </Grid>
        </Grid>

        <!-- Channels -->
        <Grid Grid.Column="1" Padding="6,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Suchen" TextChanged="OnSearchChanged" />
            <InfoBar x:Name="StatusBar" Grid.Row="1" Margin="0,8,0,0" IsClosable="True" />
            <Button x:Name="BackButton" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed" Click="OnBack">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Back" />
                    <TextBlock x:Name="BackLabel" />
                </StackPanel>
            </Button>
            <ListView x:Name="ChannelList" Grid.Row="3" Margin="0,8,0,0" SelectionChanged="OnChannelSelected">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ChannelRow">
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Image Source="{x:Bind Logo}" Stretch="Uniform" Margin="4" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Channel.Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind NowTitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Value="{x:Bind Progress}" Maximum="1" Visibility="{x:Bind ProgressVisibility}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Player -->
        <Grid Grid.Column="2" Padding="6,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="VideoHost" CornerRadius="12" Background="Black" SizeChanged="OnVideoHostSizeChanged">
                <TextBlock Text="Sender auswählen" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray" />
            </Border>
            <Grid x:Name="InfoPanel" Grid.Row="1" Padding="4,12,4,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="NowChannel" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="NowProgramme" TextWrapping="Wrap" />
                    <TextBlock x:Name="NextProgramme" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                    <Button x:Name="LiveButton" Click="OnLive" Visibility="Collapsed" ToolTipService.ToolTip="Sender neu synchronisieren">
                        <TextBlock Text="LIVE" FontWeight="Bold" Foreground="#E5484D" />
                    </Button>
                    <Button x:Name="SeekBackButton" Click="OnSeekBack" Visibility="Collapsed" Content="−10 s" ToolTipService.ToolTip="10 Sekunden zurück" />
                    <Button Click="OnPause" ToolTipService.ToolTip="Pause"><SymbolIcon Symbol="Pause" /></Button>
                    <Button x:Name="SeekForwardButton" Click="OnSeekForward" Visibility="Collapsed" Content="+10 s" ToolTipService.ToolTip="10 Sekunden vor" />
                    <Button Click="OnMute" ToolTipService.ToolTip="Ton aus"><SymbolIcon Symbol="Mute" /></Button>
                    <Button Click="OnFullScreen" ToolTipService.ToolTip="Vollbild"><SymbolIcon Symbol="FullScreen" /></Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
