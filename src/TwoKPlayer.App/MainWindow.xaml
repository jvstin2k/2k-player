<Window
    x:Class="TwoKPlayer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TwoKPlayer.App"
    Title="2k-Player">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
        <Grid.Resources>
            <!-- Movie and series cards on the home page -->
            <DataTemplate x:Key="PosterTemplate" x:DataType="local:ChannelRow">
                <StackPanel Width="150" Spacing="6">
                    <StackPanel.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="{x:Bind local:Strings.RemoveFavorite}" Tag="{x:Bind}" Click="OnRemoveFavorite">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE735;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </StackPanel.ContextFlyout>
                    <Border Height="225" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Image Source="{x:Bind Poster}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{x:Bind Channel.Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (content extends into it, see MainWindow constructor) -->
        <Grid x:Name="AppTitleBar" Padding="18,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleLogo" Width="18" Height="18" />
                <TextBlock Text="2k-Player" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Grid x:Name="MainGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="248" />
                <ColumnDefinition x:Name="ChannelsColumn" Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sidebar: search, sections, categories, sources -->
            <Grid x:Name="Sidebar" Grid.RowSpan="2" Padding="12,4,8,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="8">
                    <!-- Shown only with more than one source, see RefreshSourcePicker -->
                    <ComboBox x:Name="SourcePicker" HorizontalAlignment="Stretch" Visibility="Collapsed" SelectionChanged="OnSourcePicked"
                              ToolTipService.ToolTip="{x:Bind local:Strings.SourcePickerTip}" />
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="{x:Bind local:Strings.SearchPlaceholder}" QueryIcon="Find" TextChanged="OnSearchChanged" />
                </StackPanel>

                <ListView x:Name="SectionList" Grid.Row="1" SelectionChanged="OnSectionChanged">
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE80F;" FontSize="16" />
                            <TextBlock Text="{x:Bind local:Strings.Home}" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                            <TextBlock Text="{x:Bind local:Strings.LiveTv}" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE8B2;" FontSize="16" />
                            <TextBlock Text="{x:Bind local:Strings.Movies}" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" />
                            <TextBlock Text="{x:Bind local:Strings.Series}" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE787;" FontSize="16" />
                            <TextBlock Text="{x:Bind local:Strings.Guide}" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <TextBlock x:Name="CategoriesHeader" Grid.Row="2" Text="{x:Bind local:Strings.Categories}" Margin="14,10,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ListView x:Name="GroupList" Grid.Row="3" SelectionChanged="OnGroupSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextTrimming="CharacterEllipsis">
                                <TextBlock.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="{x:Bind local:Strings.HideGroup}" Tag="{x:Bind}" Click="OnHideGroup">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED1A;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </TextBlock.ContextFlyout>
                            </TextBlock>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="4" ColumnSpacing="6" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Shown only when a newer version is available, see StartAsync -->
                    <Button x:Name="UpdateButton" Grid.ColumnSpan="2" HorizontalAlignment="Stretch" Visibility="Collapsed" Click="OnUpdate"
                            ToolTipService.ToolTip="{x:Bind local:Strings.UpdateKeepsTip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock x:Name="UpdateText" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="OnAddSource">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="{x:Bind local:Strings.AddSource}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="1" Click="OnManageSources" ToolTipService.ToolTip="{x:Bind local:Strings.SettingsTip}">
                        <FontIcon Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </Grid>
            </Grid>

            <InfoBar x:Name="StatusBar" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,12,8" IsClosable="True" />

            <!-- Channel / movie / series list -->
            <Grid x:Name="ChannelPane" Grid.Column="1" Grid.Row="1" Margin="0,0,8,12" Padding="8,14,8,8" CornerRadius="12"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,0,0,8">
                    <TextBlock x:Name="SectionTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="CountText" VerticalAlignment="Bottom" Margin="0,0,0,4"
                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button x:Name="BackButton" Grid.Row="1" Margin="4,0,0,8" Visibility="Collapsed" Click="OnBack">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                        <TextBlock x:Name="BackLabel" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    </StackPanel>
                </Button>
                <ListView x:Name="ChannelList" Grid.Row="2" SelectionChanged="OnChannelSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ChannelRow">
                            <Grid ColumnSpacing="12" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Image Source="{x:Bind Logo}" Stretch="Uniform" Margin="5" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind Channel.Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{x:Bind Progress}" Maximum="1" Visibility="{x:Bind ProgressVisibility}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="OnToggleFavorite" Background="Transparent" BorderThickness="0" Padding="8"
                                        ToolTipService.ToolTip="{x:Bind local:Strings.Favorite}">
                                    <FontIcon Glyph="{x:Bind StarGlyph, Mode=OneWay}" FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Player -->
            <Grid x:Name="PlayerGrid" Grid.Column="2" Grid.Row="1" Margin="0,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="VideoHost" CornerRadius="12" Background="Black"
                        SizeChanged="OnVideoHostSizeChanged" DoubleTapped="OnVideoDoubleTapped">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Opacity="0.55">
                        <FontIcon Glyph="&#xE714;" FontSize="44" Foreground="White" />
                        <TextBlock Text="{x:Bind local:Strings.PickSomething}" Foreground="White" />
                    </StackPanel>
                </Border>

                <!-- Hidden in fullscreen, where FullscreenBar shows a copy of these controls -->
                <Grid x:Name="InfoPanel" Grid.Row="1" Margin="0,12,0,0" Padding="16,12" CornerRadius="12" ColumnSpacing="16"
                      Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Image x:Name="NowLogo" Stretch="Uniform" Margin="6" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="NowChannel" Text="{x:Bind local:Strings.NothingSelected}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="16"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="NowTime" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="NowProgramme" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ProgressBar x:Name="NowProgress" Maximum="1" Margin="0,4,0,2" Visibility="Collapsed" />
                        <TextBlock x:Name="NextProgramme" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="LiveButton" Click="OnLive" Visibility="Collapsed" CornerRadius="16" Padding="14,6"
                                Background="#E5484D" Foreground="White" BorderThickness="0" ToolTipService.ToolTip="{x:Bind local:Strings.LiveTip}">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D13438" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B32A2E" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                                <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="White" VerticalAlignment="Center" />
                                <TextBlock Text="LIVE" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SeekBackButton" Click="OnSeekBack" Visibility="Collapsed" Content="−10 s" CornerRadius="16" ToolTipService.ToolTip="{x:Bind local:Strings.SeekBackTip}" />
                        <Button Click="OnPause" Width="44" Height="44" CornerRadius="22" Padding="0" Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind local:Strings.PauseTip}">
                            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="16" />
                        </Button>
                        <Button x:Name="SeekForwardButton" Click="OnSeekForward" Visibility="Collapsed" Content="+10 s" CornerRadius="16" ToolTipService.ToolTip="{x:Bind local:Strings.SeekForwardTip}" />
                        <Button Click="OnMute" Width="40" Height="40" CornerRadius="20" Padding="0" ToolTipService.ToolTip="{x:Bind local:Strings.MuteTip}">
                            <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center"
                                ToolTipService.ToolTip="{x:Bind local:Strings.VolumeTip}" />
                        <Button Width="40" Height="40" CornerRadius="20" Padding="0" ToolTipService.ToolTip="{x:Bind local:Strings.TracksTip}">
                            <FontIcon Glyph="&#xE7F0;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="TracksFlyout" Opening="OnTracksOpening" />
                            </Button.Flyout>
                        </Button>
                        <Button Click="OnMini" Width="40" Height="40" CornerRadius="20" Padding="0" ToolTipService.ToolTip="{x:Bind local:Strings.MiniTip}">
                            <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                        </Button>
                        <Button Click="OnFullScreen" Width="40" Height="40" CornerRadius="20" Padding="0" ToolTipService.ToolTip="{x:Bind local:Strings.FullScreenTip}">
                            <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Home: favorite channels, movies and series; replaces list and player while Home is selected -->
            <ScrollViewer x:Name="HomePanel" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,0,12,12" Visibility="Collapsed">
                <StackPanel Spacing="8" Padding="8,4,8,24">
                    <Grid ColumnSpacing="12" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind local:Strings.Home}" Style="{StaticResource TitleTextBlockStyle}" />
                        <!-- Playback goes on in the background; this leads back to the player -->
                        <Button x:Name="NowPlayingButton" Grid.Column="1" Visibility="Collapsed" Click="OnBackToPlayer" CornerRadius="16">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock x:Name="NowPlayingText" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="HomeEmpty" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,24,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind local:Strings.HomeEmpty}" />

                    <TextBlock x:Name="HomeLiveHeader" Text="{x:Bind local:Strings.Channels}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                    <GridView x:Name="HomeLive" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnHomeItemClick"
                              ScrollViewer.VerticalScrollMode="Disabled">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:ChannelRow">
                                <StackPanel Width="200" Padding="12" Spacing="6" CornerRadius="12"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="{x:Bind local:Strings.RemoveFavorite}" Tag="{x:Bind}" Click="OnRemoveFavorite">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE735;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </StackPanel.ContextFlyout>
                                    <Border Height="100" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Image Source="{x:Bind Logo}" Stretch="Uniform" Margin="14" />
                                    </Border>
                                    <TextBlock Text="{x:Bind Channel.Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Value="{x:Bind Progress}" Maximum="1" Visibility="{x:Bind ProgressVisibility}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <TextBlock x:Name="HomeMoviesHeader" Text="{x:Bind local:Strings.Movies}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                    <GridView x:Name="HomeMovies" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnHomeItemClick"
                              ScrollViewer.VerticalScrollMode="Disabled" ItemTemplate="{StaticResource PosterTemplate}" />

                    <TextBlock x:Name="HomeSeriesHeader" Text="{x:Bind local:Strings.Series}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                    <GridView x:Name="HomeSeries" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnHomeItemClick"
                              ScrollViewer.VerticalScrollMode="Disabled" ItemTemplate="{StaticResource PosterTemplate}" />
                </StackPanel>
            </ScrollViewer>

            <!-- TV guide: replaces list and player while the TV-Guide section is selected -->
            <Grid x:Name="GuidePanel" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,0,12,12" CornerRadius="12" Visibility="Collapsed"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="GuideContent" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Canvas x:Name="GuideTimeline" />
                        <ListView x:Name="GuideList" Grid.Row="1" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:GuideRow">
                                    <Grid Height="64">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Click="OnGuideChannelClick" Background="Transparent" BorderThickness="0" Margin="4,3"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Image Source="{x:Bind Logo}" Width="36" Height="36" />
                                                <TextBlock Text="{x:Bind Channel.Name}" Width="150" VerticalAlignment="Center"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Blocks}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:GuideBlock">
                                                    <Button Margin="{x:Bind Margin}" Width="{x:Bind BlockWidth}" Padding="10,4" CornerRadius="8"
                                                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                                            Click="OnGuideBlockClick" ToolTipService.ToolTip="{x:Bind Programme.Description}">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Visibility="{x:Bind NowVisibility}"
                                                                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind Time}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Rectangle x:Name="NowLine" Grid.RowSpan="2" Width="2" HorizontalAlignment="Left" IsHitTestVisible="False"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
